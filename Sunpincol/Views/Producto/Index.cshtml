
@model IEnumerable<Sunpincol.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo producto</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio unitario</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.CodigoProducto</td>
                <td>@producto.NombreProducto</td>
                <td>@producto.Categoria</td>
                <td>@producto.PrecioUnitario.ToString("N2")</td>
                <td>@producto.Descripcion</td>
                <td>@(producto.EstadoProducto ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@producto.CodigoProducto">Editar</a> |
                    <a asp-action="Details" asp-route-id="@producto.CodigoProducto">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@producto.CodigoProducto">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

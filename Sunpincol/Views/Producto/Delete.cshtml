@model Sunpincol.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>

<h3>¿Estás seguro de que deseas eliminar este producto?</h3>

<div>
    <h4>Producto</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.CodigoProducto</dd>

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.NombreProducto</dd>

        <dt class="col-sm-3">Categoría</dt>
        <dd class="col-sm-9">@Model.Categoria</dd>

        <dt class="col-sm-3">Precio unitario</dt>
        <dd class="col-sm-9">@Model.PrecioUnitario</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@(Model.EstadoProducto ? "Activo" : "Inactivo")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CodigoProducto" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
